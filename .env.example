# ==============================================================================
# SciGraph — Scientific Intelligence Workspace :: Environment Configuration
# ==============================================================================

# Application Engine ('ollama' for local sovereignty or 'openai' for cloud acceleration)
LLM_ENGINE=ollama

# Local Inference (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
LLM_NUM_CTX=8192

# Cloud Acceleration (Groq / OpenAI-Compatible API)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your_groq_or_openai_api_key_here

# Vision Model (Optional - for Multimodal Equation and Chart OCR)
VISION_MODEL=

# Knowledge Graph Storage ('NetworkXStorage' for zero-setup local or 'Neo4JStorage')
GRAPH_STORAGE=NetworkXStorage
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Storage Directories (Defaults to workspace data/ directory)
WORKING_DIR=data/rag_storage
UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/output

# Ingestion & Parsing Settings
PARSER=mineru
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=150
ENABLE_LOCAL_RERANKER=false
RERANK_BY_DEFAULT=false
