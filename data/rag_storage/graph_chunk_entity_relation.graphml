  <data key="d4">GA-Unit-4.pdf</data>
  <data key="d5">1793742990</data>
  <data key="d6"></data>
</node>
<node id="Track Interdependence">
  <data key="d0">Track Interdependence</data>
  <data key="d3">chunk-5f962918487ef320fd45d2de09dceac4</data>
  <data key="d2">Composers can tune the ratio between shared and track-private noise to control inter-track dynamics.</data>
