  <data key="d0">PCA</data>
  <data key="d1">method</data>
  <data key="d2">Principal Component Analysis (PCA) is a technique used for reducing the dimensionality of high-dimensional data while retaining most of the variance in the data.</data>
  <data key="d3">chunk-6b7bb64c7c77afa990b98fea6bfe6daa</data>
