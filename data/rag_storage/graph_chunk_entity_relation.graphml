  <data key="d3">chunk-140833bd08793c8ef46f4afbc10aa877</data>
  <data key="d2">Measures the similarity between the distribution of 12 chromatic pitch classes in generated music and a target dataset.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">GA-Unit-4.pdf</data>
  <data key="d5">1793742990</data>
  <data key="d6"></data>
</node>
<node id="Temporal Model">
