test documents/
test_documents/
assets/

# Generated runtime data, vector stores & graph storage
data/
data/rag_storage/
data/uploads/
data/output/
data/benchmark_test_files/

# Temporary test outputs & one-off debug scripts in scripts
scripts/*.json
scripts/check_jobs.py
