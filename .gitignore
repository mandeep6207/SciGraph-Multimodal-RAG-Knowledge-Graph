# Secrets, Environment & Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.token

# Python compiled bytecode & runtime cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Dependencies & Build Artifacts
node_modules/
dist/
build/
*.egg-info/

# Local cache & temporary files
.cache/
*.log
*.tmp
*.temp
tmp/
temp/
chrome_temp/
screenshots/chrome_temp/

